# ===========================================================================
# ForensIQ — .gitignore
# Depoda yalnızca KAYNAK KOD bulunur. Model ağırlıkları, üretilen belgeler,
# yerel geliştirme kayıtları ve test görselleri dışarıda tutulur.
# ===========================================================================

# --- Sanal ortam ve gizli bilgiler ---------------------------------------
.venv/
venv/
env/
.env

# --- Model dosyaları (toplam ~1,9 GB) -------------------------------------
# İndirme: python tools/download_models.py
clip_weights.pth
clip_processor/
models/

# --- Python ---------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- IDE ------------------------------------------------------------------
.vscode/
.idea/

# --- Log ------------------------------------------------------------------
*.log

# --- Görseller ------------------------------------------------------------
# Test seti ve üretilen fixture'lar depoya girmez.
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.tiff
tests/fixtures/

# ===========================================================================
# YEREL BELGELER — depoya gönderilmez
# ===========================================================================

# --- Word belgeleri -------------------------------------------------------
# Hem proje tanımı ("Proje II.docx") hem de teslim için üretilen belgeler.
# Teslim hocaya doğrudan yapılır; depo yalnızca kodu taşır.
*.docx
*.doc

# --- Geliştirme günlüğü ---------------------------------------------------
# Analiz, kararlar, ölçümler ve iş günlüğü yerelde tutulur.
gelistirme/

# --- Belge klasörü --------------------------------------------------------
# Doxygen çıktısı (üretilir), belge kaynakları ve teslim belgeleri.
# Yeniden üretmek için:
#   doxygen Doxyfile
#   python tools/md_to_docx.py
docs/
